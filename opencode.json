{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "127.0.0.1",
    "port": 4096,
    "mdns": false
  },
  "default_agent": "telegram-operator",
  "share": "manual",
  "snapshot": true,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "npm run build*": "deny",
      "npm run compile*": "deny",
      "npm run dist*": "deny",
      "npm run prod*": "deny",
      "npm install*": "deny",
      "npm ci*": "deny",
      "pnpm build*": "deny",
      "pnpm install*": "deny",
      "yarn install*": "deny",
      "bun install*": "deny",
      "pip install*": "deny",
      "pip3 install*": "deny",
      "python -m pip install*": "deny",
      "python3 -m pip install*": "deny",
      "uv pip install*": "deny",
      "bash -c *": "deny",
      "sh -c *": "deny",
      "zsh -c *": "deny",
      "pnpm run build*": "deny",
      "yarn build*": "deny",
      "npx webpack*": "deny",
      "npx rollup*": "deny",
      "npx vite build*": "deny",
      "npx esbuild*": "deny",
      "npx tsc*": "deny",
      "npx next build*": "deny",
      "npx nuxt build*": "deny",
      "make *": "deny",
      "cmake *": "deny",
      "ninja *": "deny",
      "cargo build*": "deny",
      "cargo package*": "deny",
      "cargo install*": "deny",
      "go build*": "deny",
      "go install*": "deny",
      "mvn *": "deny",
      "gradle *": "deny",
      "./gradlew *": "deny",
      "javac *": "deny",
      "docker build*": "deny",
      "docker compose build*": "deny",
      "docker-compose build*": "deny",
      "flutter build*": "deny",
      "dotnet build*": "deny",
      "dotnet publish*": "deny",
      "cargo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "mkfs*": "deny",
      "dd *of=/dev/*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "systemctl reboot*": "deny",
      "systemctl poweroff*": "deny"
    },
    "external_directory": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "question": "allow",
    "doom_loop": "ask"
  },
  "agent": {
    "telegram-operator": {
      "description": "وكيل عمليات عربي للبوت: ينفذ المهام ضمن الخادم بلا خطوات بناء أو تجميع.",
      "mode": "primary",
      "prompt": "{file:./prompts/telegram-operator-ar.md}",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "bash": {
          "*": "allow",
          "npm run build*": "deny",
          "npm run compile*": "deny",
          "npm run dist*": "deny",
          "npm run prod*": "deny",
          "pnpm build*": "deny",
          "pnpm run build*": "deny",
