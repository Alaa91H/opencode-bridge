{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "127.0.0.1",
    "port": 4096,
    "mdns": false
  },
  "default_agent": "development-agent",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "share": "manual",
  "snapshot": true,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "bash": {
      "*": "deny",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git remote -v": "allow",
      "git fetch*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push origin *": "allow",
      "git pull --ff-only*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh workflow view*": "allow",
      "gh api *": "allow",
      "gh repo view*": "allow",
      "gh pr view*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "gh auth*": "deny",
      "gh repo delete*": "deny",
      "npm*": "deny",
      "pnpm*": "deny",
      "yarn*": "deny",
      "make*": "deny",
      "cmake*": "deny",
      "ninja*": "deny",
      "cargo*": "deny",
      "go build*": "deny",
      "mvn*": "deny",
      "gradle*": "deny",
      "./gradlew*": "deny",
      "docker*": "deny",
      "pip*": "deny",
      "python*": "deny",
      "bash*": "deny",
      "sh*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "sudo*": "deny",
      "pip install*": "deny",
      "pip3 install*": "deny",
      "python -m pip install*": "deny",
      "python3 -m pip install*": "deny",
      "npm install*": "deny",
      "npm run build*": "deny",
      "docker build*": "deny"
    },
    "external_directory": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "question": "allow",
    "doom_loop": "ask"
  },
  "agent": {
    "development-agent": {
      "description": "Multi-repository Git/GitHub development agent without local builds.",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "{file:./prompts/development-agent-ar.md}"
    }
  }
}
