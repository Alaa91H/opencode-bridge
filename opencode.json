          "npx vite build*": "deny",
          "npx esbuild*": "deny",
          "npx tsc*": "deny",
          "npx next build*": "deny",
          "npx nuxt build*": "deny",
          "make *": "deny",
          "cmake *": "deny",
          "ninja *": "deny",
          "cargo build*": "deny",
          "cargo package*": "deny",
          "cargo install*": "deny",
          "go build*": "deny",
          "go install*": "deny",
          "mvn *": "deny",
          "gradle *": "deny",
          "./gradlew *": "deny",
          "javac *": "deny",
          "docker build*": "deny",
          "docker compose build*": "deny",
          "docker-compose build*": "deny",
          "flutter build*": "deny",
          "dotnet build*": "deny",
          "dotnet publish*": "deny",
          "rm -rf /": "deny",
