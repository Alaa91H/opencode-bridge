          "shutdown*": "deny",
          "reboot*": "deny",
          "halt*": "deny",
          "poweroff*": "deny",
          "systemctl reboot*": "deny",
          "systemctl poweroff*": "deny"
        },
        "external_directory": "allow",
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "question": "allow",
        "doom_loop": "ask"
      }
    }
  }
}
