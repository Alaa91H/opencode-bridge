# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_PROXY_URL=
TELEGRAM_ATTACHMENT_MAX_BYTES=20971520
TELEGRAM_DAILY_TASK_COUNTER_TIMEZONE=Europe/Berlin

# OpenCode
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096
OPENCODE_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_DEFAULT_MODEL=opencode/muse-spark-1.3-contributor-free
OPENCODE_MODEL_VARIANT=xhigh
OPENCODE_VARIANT_MODEL=opencode/muse-spark-1.3-contributor-free
OPENCODE_PIN_DEFAULT_MODEL=0
OPENCODE_AGENT=development-agent
OPENCODE_MODEL_SYNC_SECONDS=900
# Local daily estimate for the opaque Zen free-tier quota. OpenCode currently
# does not publish an exact remaining counter to clients.
OPENCODE_FREE_DAILY_POINTS=200

# Daily free OpenCode agent/model scout
# The live zero-cost Zen catalog is re-evaluated every day and the strongest
# coding-agent candidate is selected automatically. The configured default is
# only a safe fallback while OPENCODE_PIN_DEFAULT_MODEL=0.
AGENT_SCOUT_INTERVAL_SECONDS=86400
AGENT_SCOUT_AUTO_STRONGEST=1
AGENT_SCOUT_PREFERRED_AGENT=development-agent
AGENT_SCOUT_WEB_RESEARCH=1

# V3 development workspaces
GITHUB_WORKSPACE_ROOT=/home/ubuntu/github-workspaces
GITHUB_ALLOWED_REPOS=Alaa91H/opencode-bridge,Alaa91H/QuranLiveStream
# Optional GitHub token raises REST API rate limits for CI monitoring. Never expose it to prompts.
GITHUB_TOKEN=
# Exact Actions workflow name used by /ci. Leave blank to show the latest workflow of any name.
GITHUB_CI_WORKFLOW=CI
# Upper bound. V3 automatically reduces this value on constrained hosts.
AGENT_TASK_WORKERS=2
AGENT_ADAPTIVE_WORKERS=1

# Autonomous watchdog
# Lightweight health cycle interval. No builds or package installs are performed.
WATCHDOG_INTERVAL_SECONDS=300
# Running tasks older than this are flagged for manual review; they are never killed automatically.
WATCHDOG_STALE_TASK_SECONDS=7200
# Restart guardrails for the two allow-listed user services only.
WATCHDOG_RESTART_COOLDOWN_SECONDS=300
WATCHDOG_MAX_RESTARTS_PER_HOUR=3

# Logging
LOG_LEVEL=INFO
