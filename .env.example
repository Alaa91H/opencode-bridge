# Optional central TOML/JSON configuration file. Environment variables override it.
BRIDGE_CONFIG_FILE=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_PROXY_URL=
TELEGRAM_ATTACHMENT_MAX_BYTES=20971520
# أقصى عدد مرفقات مرتبطة بمهمة واحدة (يشمل الألبومات والملفات المعلّقة).
TELEGRAM_ATTACHMENT_MAX_COUNT=10
# الحد الإجمالي لكل مرفقات المهمة. الحد الفردي أعلاه يبقى مطبقًا أيضًا.
TELEGRAM_ATTACHMENT_MAX_TOTAL_BYTES=52428800
# الملف المرسل بلا Caption ينتظر هذا العدد من الثواني كي ترسل الأمر النصي.
TELEGRAM_ATTACHMENT_PENDING_SECONDS=600
# مهلة قصيرة لتجميع عناصر ألبوم Telegram في مهمة واحدة.
TELEGRAM_MEDIA_GROUP_DEBOUNCE_SECONDS=1.25
# بداية اليوم للعداد الظاهر في البوت؛ القيمة الافتراضية عند غيابها هي Etc/GMT-2.
TELEGRAM_DAILY_TASK_COUNTER_TIMEZONE=Etc/GMT-2

# OpenCode
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096
OPENCODE_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_DEFAULT_MODEL=opencode/muse-spark-1.3-contributor-free
OPENCODE_MODEL_VARIANT=xhigh
OPENCODE_VARIANT_MODEL=opencode/muse-spark-1.3-contributor-free
OPENCODE_PIN_DEFAULT_MODEL=0
OPENCODE_AGENT=telegram-operator
# فاصل مزامنة كتالوج Zen بالثواني؛ يفحص البوت الكتالوج أيضًا قبل كل مهمة.
OPENCODE_MODEL_SYNC_SECONDS=900
# Local daily estimate for the opaque Zen free-tier quota. OpenCode currently
# does not publish an exact remaining counter to clients.
OPENCODE_FREE_DAILY_POINTS=200

# Daily free OpenCode agent/model scout
# يعيد تقييم نماذج Zen المجانية يوميًا ويختار الأقوى للتطوير الوكيلي.
# OPENCODE_DEFAULT_MODEL يبقى fallback آمن فقط ولا يُثبّت ما دام PIN=0.
AGENT_SCOUT_INTERVAL_SECONDS=86400
AGENT_SCOUT_AUTO_STRONGEST=1
AGENT_SCOUT_PREFERRED_AGENT=development-agent
AGENT_SCOUT_WEB_RESEARCH=1

# Task execution
# عدد المهام المستقلة التي يمكن تنفيذها بالتوازي. يبقى ترتيب مهام المستخدم الواحد محفوظًا.
AGENT_TASK_WORKERS=2
# فترة فحص الطابور عند الخمول بالثواني.
AGENT_TASK_POLL_SECONDS=5

# Autonomous watchdog
# دورة مراقبة خفيفة؛ لا تنفذ build أو تثبيت حزم.
WATCHDOG_INTERVAL_SECONDS=300
# المهام التي تتجاوز هذا العمر تُعلّم للمراجعة اليدوية ولا تُقتل تلقائيًا.
WATCHDOG_STALE_TASK_SECONDS=7200
# حواجز إعادة تشغيل الخدمتين المسموحتين فقط لمنع restart loops.
WATCHDOG_RESTART_COOLDOWN_SECONDS=300
WATCHDOG_MAX_RESTARTS_PER_HOUR=3

# Logging
LOG_LEVEL=INFO


# Telegram Bot API transport. Cloud is the safe default.
TELEGRAM_API_MODE=cloud
# Used only when TELEGRAM_API_MODE=local.
TELEGRAM_LOCAL_API_BASE_URL=http://127.0.0.1:8081/bot
TELEGRAM_LOCAL_FILE_BASE_URL=http://127.0.0.1:8081/file/bot
