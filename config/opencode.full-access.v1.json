{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "127.0.0.1",
    "port": 4096,
    "mdns": false
  },
  "default_agent": "telegram-operator",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "share": "manual",
  "snapshot": true,
  "permission": "allow",
  "agent": {
    "development-agent": {
      "description": "Authenticated Telegram full-access development/operator agent",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "{file:./prompts/full-access-operator-ar.md}",
      "permission": "allow"
    },
    "telegram-operator": {
      "description": "Authenticated Telegram full-access development/operator agent",
      "mode": "primary",
      "permission": "allow",
      "prompt": "{file:./prompts/full-access-operator-ar.md}"
    }
  }
}
