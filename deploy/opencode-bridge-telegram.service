[Unit]
Description=OpenCode V3 Telegram Development Bridge
After=network-online.target opencode-serve.service
Wants=network-online.target opencode-serve.service
PartOf=opencode-bridge.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/opencode-bridge
EnvironmentFile=-/home/ubuntu/opencode-bridge/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/opencode-bridge/venv/bin/python -m run_v3
Restart=on-failure
RestartSec=3
# Back off exponentially (3s -> 60s) instead of restarting forever at a fixed pace (systemd >= 254).
RestartSteps=5
RestartMaxDelaySec=60
TimeoutStopSec=30
NoNewPrivileges=yes
# Safe hardening: no filesystem restrictions, so Freebuff can still read its
# config directory and the configured workspace.
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Safety ceilings only: the bridge idles at ~45 MiB, so these never constrain normal operation.
MemoryHigh=50%
TasksMax=512

# Freebuff CLI backend (optional). Install and log in once as the service user:
#   npm install -g freebuff && freebuff login
# Then configure .env (AGENT_BACKEND, FREEBUFF_WORKSPACE, FREEBUFF_BIN).
# The CLI runs inside a PTY with a minimal environment; see docs/freebuff-integration-ar.md.

[Install]
WantedBy=opencode-bridge.target
