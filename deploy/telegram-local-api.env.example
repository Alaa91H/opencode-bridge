# Telegram Local Bot API Server profile.
#
# The bridge reads these names from .env. The values must NOT end with a
# trailing slash: python-telegram-bot concatenates the bot token directly onto
# the base URL, so ".../bot/" produces an invalid path and the server rejects
# the token with Unauthorized.
#
# The Local Bot API server itself needs no file-root setting here; it manages
# its own working directory (WorkingDirectory in its unit file).
TELEGRAM_API_MODE=local
TELEGRAM_LOCAL_API_BASE_URL=http://127.0.0.1:8081/bot
TELEGRAM_LOCAL_FILE_BASE_URL=http://127.0.0.1:8081/file/bot

# Run the Local Bot API service as a dedicated unprivileged user.
# Recommended systemd hardening:
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=true
# RestrictSUIDSGID=true
# CapabilityBoundingSet=
