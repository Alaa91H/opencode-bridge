# Cloud remains the default in .env.example.
TELEGRAM_API_MODE=local
TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081
TELEGRAM_LOCAL_API_FILE_ROOT=/var/lib/telegram-bot-api
# Run the Local Bot API service as a dedicated unprivileged user.
# Recommended systemd hardening:
# NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=true
# RestrictSUIDSGID=true
# CapabilityBoundingSet=
