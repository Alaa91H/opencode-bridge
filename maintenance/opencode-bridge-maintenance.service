[Unit]
Description=OpenCode Bridge Daily Safe Maintenance
Documentation=file:/home/ubuntu/opencode-bridge/DEPLOYMENT_AR.md
Wants=network-online.target
After=network-online.target apt-daily-upgrade.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/opencode-bridge-maintenance
TimeoutStartSec=90min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/opencode-bridge/runtime
