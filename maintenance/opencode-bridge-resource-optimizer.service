[Unit]
Description=OpenCode Bridge ZRAM and Host Resource Optimizer
After=local-fs.target
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/opencode-bridge-resource-optimizer
RemainAfterExit=yes
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
